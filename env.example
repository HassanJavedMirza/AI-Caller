# ── Database ───────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_debt_reminder

# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change_this_to_a_long_random_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Vapi (add when you have a paid number) ─────────────────────────────────
# Get these from: https://dashboard.vapi.ai
# 1. API Key      → Settings → API Keys
# 2. Phone Number → Phone Numbers → Buy Number (~$2/mo)
# 3. Assistant ID → Assistants → Create Assistant
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=
VAPI_ASSISTANT_ID=
